# Copy to .env and replace every "change-me" value.
# Generate passwords with: openssl rand -base64 24 | tr -d '/+='

# --- Docker Compose (Postgres bootstrap) ---
POSTGRES_SUPERUSER_PASSWORD=change-me
DB_OWNER_PASSWORD=change-me
DB_APP_PASSWORD=change-me
POSTGRES_HOST_PORT=5434

# --- API runtime: connects as the restricted app role ---
DATABASE_URL=postgres://agent_dashboard_app:change-me@127.0.0.1:5434/agent_dashboard
# --- Migrations and seeds: connect as the owner role ---
MIGRATION_DATABASE_URL=postgres://agent_dashboard_owner:change-me@127.0.0.1:5434/agent_dashboard

# --- Integration tests: same roles, separate database ---
TEST_DATABASE_URL=postgres://agent_dashboard_app:change-me@127.0.0.1:5434/agent_dashboard_test
TEST_MIGRATION_DATABASE_URL=postgres://agent_dashboard_owner:change-me@127.0.0.1:5434/agent_dashboard_test

NODE_ENV=development
API_PORT=3000
LOG_LEVEL=info

# --- Security ---
# Browser origins allowed to make state-changing requests. Required in
# production; defaults to the Vite dev server in development.
# APP_ORIGINS=https://dashboard.lab.example
# Number of reverse proxies in front of the API (0 when none).
TRUST_PROXY_HOPS=0

# --- Skill storage ---
# Absolute path for published skill files. Defaults to <repo>/data/skills.
# SKILL_STORAGE_DIR=/srv/agent-dashboard/skills
